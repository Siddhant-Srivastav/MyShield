{
  "expo": {
    "name": "MyShield",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/myshield-shield.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pick a photo for emergency identification."
      }
    },
    "android": {
      "package": "com.myshield.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
  "foregroundImage": "./assets/images/myshield-shield.png",
  "backgroundColor": "#0A1628"
},
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a30f9dd-3813-4b46-9697-c0b17d23d7e5"
      }
    }
  }
}
